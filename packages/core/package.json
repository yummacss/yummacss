{
	"name": "@yummacss/core",
	"version": "4.10.0",
	"description": "Core utility definitions for Yumma CSS",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/core"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@types/culori": "^4.0.1",
		"culori": "4.0.2"
	}
}
