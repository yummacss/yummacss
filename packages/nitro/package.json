{
	"name": "@yummacss/nitro",
	"version": "3.8.1",
	"description": "The engine behind Yumma CSS.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"files": [
		"dist"
	],
	"types": "./dist/index.d.mts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser.d.mts",
			"import": "./dist/browser.mjs"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/nitro"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"prepublishOnly": "pnpm build"
	},
	"packageManager": "pnpm@10.27.0",
	"dependencies": {
		"@yummacss/api": "workspace:*",
		"globby": "^16.1.0",
		"zod": "^4.3.4"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}