{
	"name": "@yummacss/nitro",
	"version": "0.5.1",
	"description": "The engine behind Yumma CSS.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"files": [
		"dist"
	],
	"types": "./dist/index.d.mts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser.d.mts",
			"import": "./dist/browser.mjs"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/nitro.git"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "biome check --write"
	},
	"packageManager": "pnpm@10.27.0",
	"dependencies": {
		"@yummacss/api": "^1.8.0",
		"globby": "^16.1.0",
		"zod": "^4.3.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/node": "^25.0.3",
		"tsdown": "^0.18.4",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": false
	}
}
