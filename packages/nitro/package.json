{
	"name": "@yummacss/nitro",
	"version": "3.13.0",
	"description": "Fast CSS generation for Yumma CSS.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/nitro"
	},
	"license": "MIT",
	"author": "Renildo Pereira",
	"type": "module",
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.mts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./browser": {
			"types": {
				"import": "./dist/browser.d.mts",
				"require": "./dist/browser.d.cts"
			},
			"import": "./dist/browser.mjs",
			"require": "./dist/browser.cjs"
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/core": "workspace:*",
		"globby": "^16.1.0",
		"zod": "^4.3.4"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
