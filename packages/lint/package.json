{
	"name": "@yummacss/lint",
	"version": "4.8.0",
	"description": "Lint rules for Yumma CSS, for Oxlint",
	"keywords": [
		"ai",
		"css-framework",
		"eslint-plugin",
		"lint",
		"linter",
		"oxlint",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/lint"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/core": "workspace:*",
		"@yummacss/nitro": "workspace:*"
	}
}
