{
	"name": "@yummacss/lint",
	"version": "4.0.1",
	"description": "Class validator for Yumma CSS",
	"keywords": [
		"ai",
		"css-framework",
		"lint",
		"linter",
		"typescript",
		"validator",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/lint"
	},
	"license": "MIT",
	"author": "Renildo Pereira",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"bin": {
		"yummacss-lint": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/nitro": "workspace:*",
		"tinyglobby": "^0.2.15"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
