{
	"name": "yummacss",
	"version": "4.11.0",
	"description": "An atomic CSS framework.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/cli"
	},
	"bin": {
		"yummacss": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		},
		"./merge": {
			"types": "./dist/merge.d.mts",
			"default": "./dist/merge.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node scripts/generate-merge-map.mjs && vp pack",
		"dev": "vp pack --watch",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/core": "workspace:*",
		"@yummacss/nitro": "workspace:*"
	},
	"devDependencies": {
		"@clack/prompts": "^1.8.1",
		"@types/picomatch": "^4.0.3",
		"picomatch": "^4.0.7",
		"tinyglobby": "^0.2.15"
	},
	"packageManager": "pnpm@10.27.0"
}
