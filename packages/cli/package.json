{
	"name": "yummacss",
	"version": "3.28.1",
	"description": "Utility CSS with no new vocabulary. Class names are derived from CSS property names, so if you know CSS, you already know Yumma.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": "Renildo Pereira",
	"type": "module",
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"module": "./dist/index.mjs",
	"bin": {
		"yummacss": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/nitro": "workspace:*"
	},
	"devDependencies": {
		"tinyglobby": "^0.2.15"
	},
	"packageManager": "pnpm@10.27.0",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
