{
	"name": "yummacss",
	"version": "3.9.0",
	"description": "A CLI-first CSS framework for the web with abbreviated styles.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs"
	},
	"bin": {
		"yummacss": "./dist/index.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/cli"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"prepublishOnly": "pnpm build"
	},
	"packageManager": "pnpm@10.27.0",
	"dependencies": {
		"@yummacss/nitro": "workspace:*",
		"chokidar": "^5.0.0",
		"commander": "^14.0.2",
		"globby": "^16.1.0",
		"lightningcss": "^1.30.2",
		"ora": "^9.0.0",
		"stringify-object": "^6.0.0"
	},
	"devDependencies": {
		"@types/stringify-object": "^4.0.5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}