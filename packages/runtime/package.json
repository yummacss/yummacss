{
	"name": "@yummacss/runtime",
	"version": "3.10.1",
	"description": "Zero-config browser runtime for Yumma CSS.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"files": [
		"dist"
	],
	"main": "./dist/index.iife.js",
	"jsdelivr": "./dist/index.iife.js",
	"unpkg": "./dist/index.iife.js",
	"type": "module",
	"exports": {
		".": "./dist/index.iife.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/runtime"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/nitro": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
