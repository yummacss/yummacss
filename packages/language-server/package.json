{
	"name": "@yummacss/language-server",
	"version": "3.28.2",
	"description": "Language server for Yumma CSS - completion, hover, diagnostics, color decorators, and sorting for any LSP-compatible editor",
	"keywords": [
		"css-framework",
		"editor",
		"language-server",
		"lsp",
		"typescript",
		"yummacss",
		"zed"
	],
	"homepage": "https://yummacss.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/language-server"
	},
	"license": "MIT",
	"author": "Renildo Pereira",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"bin": {
		"yummacss-language-server": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/intellisense": "workspace:*",
		"@yummacss/nitro": "workspace:*",
		"vscode-languageserver": "^10.1.0",
		"vscode-languageserver-textdocument": "^1.0.12"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
