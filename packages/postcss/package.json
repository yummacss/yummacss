{
	"name": "@yummacss/postcss",
	"version": "4.9.0",
	"description": "PostCSS plugin for Yumma CSS",
	"keywords": [
		"css-framework",
		"nextjs",
		"postcss",
		"postcss-plugin",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git",
		"directory": "packages/postcss"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@yummacss/nitro": "workspace:*"
	},
	"devDependencies": {
		"postcss": "^8.5.18"
	},
	"peerDependencies": {
		"postcss": "^8.0.0"
	}
}
