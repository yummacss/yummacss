{
  "name": "@yummacss/api",
  "version": "3.9.0",
  "description": "The API behind Yumma CSS.",
  "keywords": [
    "css-framework",
    "typescript",
    "yummacss"
  ],
  "homepage": "https://yummacss.com",
  "license": "MIT",
