{
  "name": "yummacss",
  "version": "3.1.0",
  "description": "A CSS framework for the web with abbreviated styles.",
  "keywords": [
    "css-framework",
    "css",
    "design-system",
    "framework",
    "lightningcss",
    "responsive-design",
    "responsive",
    "scss",
    "yummacss"
  ],
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "files": [
    "dist/cli",
    "src"
  ],
  "main": "./dist/cli/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/cli/src/cli.js"
  },
  "bin": {
    "yummacss": "./dist/cli/src/cli.js",
    "yumma": "./dist/cli/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yumma-lib/yumma-css.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cli.json",
    "dev": "tsc -p tsconfig.cli.json --watch",
    "format:cli": "pnpx prettier --write cli",
    "format": "pnpx prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "globby": "^14.1.0",
    "lightningcss": "^1.29.3",
    "ora": "^8.2.0",
    "purgecss": "^7.0.2",
    "sass-embedded": "^1.85.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
