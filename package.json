{
  "name": "@yummacss/runtime",
  "version": "0.3.0",
  "description": "Zero-config browser runtime for Yumma CSS.",
  "keywords": [
    "css-framework",
    "typescript",
    "yummacss"
  ],
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "files": [
    "dist"
  ],
  "main": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "unpkg": "./dist/index.iife.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.iife.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yumma-css/runtime.git"
  },
  "scripts": {
