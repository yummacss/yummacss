{
  "name": "@yummacss/api",
  "version": "1.8.0",
  "description": "The API behind Yumma CSS.",
  "keywords": [
    "css-framework",
    "typescript",
    "yummacss"
  ],
  "license": "MIT",
  "author": "Renildo Pereira",
  "files": [
    "dist"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yumma-lib/yumma-css-api.git"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "biome check --write",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "^25.0.3",
    "@types/tinycolor2": "^1.4.6",
    "tsdown": "^0.18.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}