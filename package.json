{
  "name": "yummacss",
  "version": "3.4.2",
  "description": "A CSS framework for the web with abbreviated styles.",
  "keywords": [
    "css-framework",
    "typescript",
    "yummacss"
  ],
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "yummacss": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yumma-lib/yumma-css.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format:cli": "prettier --write cli",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@yummacss/api": "^1.6.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "globby": "^14.1.0",
    "lightningcss": "^1.30.1",
    "ora": "^8.2.0",
    "stringify-object": "^6.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/stringify-object": "^4.0.5",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
