{
	"name": "yummacss",
	"version": "3.27.0",
	"private": true,
	"description": "Utility CSS with no new vocabulary. Class names are derived from CSS property names, so if you know CSS, you already know Yumma.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git"
	},
	"license": "MIT",
	"author": "Renildo Pereira",
	"scripts": {
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"clean": "pnpm -r clean",
		"dev": "pnpm -r --parallel dev",
		"lint": "pnpm -r lint",
		"pnpm:update": "pnpm self-update",
		"publish-packages": "pnpm -r publish",
		"sort": "sort-package-json \"package.json\" \"packages/**/package.json\"",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/node": "^25.0.3",
		"postcss": "^8.5.6",
		"sort-package-json": "^3.6.1",
		"tsdown": "^0.18.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	},
	"packageManager": "pnpm@10.30.3"
}
