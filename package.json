{
	"name": "yummacss",
	"version": "3.8.0",
	"private": true,
	"description": "Monorepo for Yumma CSS - A CLI-first CSS framework for the web with abbreviated styles.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git"
	},
	"scripts": {
		"build": "pnpm -r --filter './packages/**' build",
		"dev": "pnpm -r --filter './packages/**' --parallel dev",
		"lint": "pnpm -r --filter './packages/**' lint",
		"check": "pnpm -r --filter './packages/**' check",
		"clean": "pnpm -r --filter './packages/**' exec rm -rf dist node_modules",
		"publish-packages": "pnpm -r --filter './packages/**' publish"
	},
	"packageManager": "pnpm@10.27.0",
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/node": "^25.0.3",
		"tsdown": "^0.18.4",
		"typescript": "^5.9.3"
	}
}