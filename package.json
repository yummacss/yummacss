{
  "name": "yummacss",
  "version": "3.0.1",
  "description": "A CSS framework for the web with abbreviated styles.",
  "keywords": [
    "css",
    "gulp",
    "scss",
    "yummacss"
  ],
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "files": [
    "dist/cli",
    "src"
  ],
  "main": "./dist/cli/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/cli/src/cli.js"
  },
  "bin": {
    "yummacss": "./dist/cli/src/cli.js",
    "yumma": "./dist/cli/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yumma-lib/yumma-css"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:css": "gulp build",
    "build": "pnpm build:cli",
    "dev": "tsc -p tsconfig.cli.json --watch",
    "format:cli": "pnpx prettier --write cli",
    "prepublishOnly": "pnpm build:cli"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "globby": "^14.1.0",
    "lightningcss": "^1.29.3",
    "ora": "^8.2.0",
    "purgecss": "^7.0.2",
    "sass-embedded": "^1.85.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/node": "^22.13.10",
    "gulp": "^5.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-debug": "^5.0.1",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^6.0.0",
    "sass": "^1.85.1",
    "typescript": "^5.8.2"
  }
}