{
	"name": "@yummacss/nitro",
	"version": "0.4.0",
	"description": "The engine behind Yumma CSS.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"files": [
		"dist"
	],
	"types": "./dist/index.d.mts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser.d.mts",
			"import": "./dist/browser.mjs"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yumma-lib/yumma-css-nitro.git"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "biome check --write"
	},
	"packageManager": "pnpm@10.26.2",
	"dependencies": {
		"@yummacss/api": "^1.7.2",
		"globby": "^16.1.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/node": "^25.0.3",
		"tsdown": "^0.18.3",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": false
	}
}
