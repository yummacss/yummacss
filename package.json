{
	"name": "yummacss",
	"version": "4.8.0",
	"private": true,
	"description": "An atomic CSS framework.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git"
	},
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"build:site": "pnpm --filter yummacss-docs build",
		"bump": "node scripts/bump-version.mjs",
		"check": "vp check",
		"check:site": "pnpm --filter yummacss-docs check-types",
		"clean": "pnpm -r clean",
		"dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
		"dev:site": "pnpm --filter yummacss-docs dev",
		"lint": "vp check --fix",
		"pnpm:update": "pnpm self-update",
		"publish-packages": "pnpm -r publish",
		"release": "node scripts/release.mjs",
		"sort": "sort-package-json \"package.json\" \"packages/**/package.json\"",
		"test": "vp test run",
		"test:site": "pnpm --filter yummacss-docs test",
		"test:watch": "vp test"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"@yummacss/lint": "workspace:*",
		"oxlint": "^1.86.0",
		"postcss": "^8.5.18",
		"sort-package-json": "^3.6.1",
		"typescript": "^5.9.3",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@10.30.3"
}
