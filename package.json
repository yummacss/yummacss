{
  "name": "yummacss",
  "version": "3.2.0",
  "description": "A CSS framework for the web with abbreviated styles.",
  "keywords": [
    "css-framework",
    "css",
    "design-system",
    "framework",
    "lightningcss",
    "responsive-design",
    "responsive",
    "scss",
    "typescript",
    "yummacss"
  ],
  "homepage": "https://yummacss.com",
  "license": "MIT",
  "author": "Renildo Pereira",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "yummacss": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yumma-lib/yumma-css.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format:cli": "prettier --write cli",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "commander": "^14.0.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-sass": "^6.0.1",
    "ora": "^8.2.0",
    "sass": "^1.90.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
