{
	"name": "yummacss",
	"version": "3.10.1",
	"private": true,
	"description": "A CLI-first CSS framework for the web with abbreviated styles.",
	"keywords": [
		"css-framework",
		"typescript",
		"yummacss"
	],
	"homepage": "https://yummacss.com",
	"license": "MIT",
	"author": "Renildo Pereira",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/yummacss.git"
	},
	"packageManager": "pnpm@10.27.0",
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"lint": "pnpm -r lint",
		"check": "pnpm -r check",
		"clean": "pnpm -r clean",
		"publish-packages": "pnpm -r publish",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/node": "^25.0.3",
		"tsdown": "^0.18.4",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}