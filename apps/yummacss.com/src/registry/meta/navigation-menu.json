{
  "summary": "A bar of links whose items open panels of links, the panel resizing and sliding as you move between them.",
  "props": [
    {
      "name": "items",
      "type": "none",
      "typeName": "NavigationItem[]",
      "example": [
        {
          "label": "Files",
          "links": [
            {
              "title": "Recent",
              "href": "/files/recent",
              "description": "What you opened this week.",
              "icon": {
                "$icon": "ClockCircleIcon",
                "size": "w:5 h:5 c:blue"
              }
            },
            {
              "title": "Starred",
              "href": "/files/starred",
              "description": "The files you keep coming back to.",
              "icon": {
                "$icon": "StarIcon",
                "size": "w:5 h:5 c:yellow"
              }
            },
            {
              "title": "Trash",
              "href": "/files/trash",
              "description": "Deleted files, kept for 30 days.",
              "icon": {
                "$icon": "TrashBinTrashIcon",
                "size": "w:5 h:5 c:red"
              }
            }
          ]
        },
        {
          "label": "Library",
          "columns": 2,
          "links": [
            {
              "title": "Photos",
              "href": "/library/photos",
              "description": "Scans & pictures, by date.",
              "icon": {
                "$icon": "GalleryIcon",
                "size": "w:5 h:5 c:mint"
              }
            },
            {
              "title": "Videos",
              "href": "/library/videos",
              "description": "Clips, with the longest first.",
              "icon": {
                "$icon": "VideoFrameIcon",
                "size": "w:5 h:5 c:red"
              }
            },
            {
              "title": "Documents",
              "href": "/library/documents",
              "description": "Notes, sheets & PDFs.",
              "icon": {
                "$icon": "DocumentIcon",
                "size": "w:5 h:5 c:blue"
              }
            },
            {
              "title": "Archives",
              "href": "/library/archives",
              "description": "Zips you have not opened.",
              "icon": {
                "$icon": "ArchiveIcon",
                "size": "w:5 h:5 c:yellow"
              }
            }
          ]
        },
        {
          "label": "Settings",
          "href": "/settings"
        }
      ],
      "description": "The bar, left to right. Each item's `label`, plus `links` for a panel (with `columns`) or `href` for a plain link."
    },
    {
      "name": "label",
      "type": "string",
      "default": "Main",
      "description": "The navigation's accessible name."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": ["rounded", "square", "squircle"],
      "default": "rounded",
      "description": "Corner radius on the bar, its items, the panel and its icon tiles."
    },
    {
      "name": "animated",
      "type": "boolean",
      "default": true,
      "description": "The panel's scale-in, its resize between items and the slide between panels. Turn it off for an instant menu, or when the user has asked for reduced motion."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Extra classes. `merge` folds them in last, so one here replaces the component's own class for the same utility."
    },
    {
      "name": "focus",
      "type": "boolean",
      "typeName": "boolean | string",
      "default": true,
      "description": "The focus outline. `true` draws it, `false` removes it along with the danger, error and success tints that ride with it, and a string of Yumma CSS utilities restyles it on every focusable part of the component, which is more than `className` reaches. Removing it outright and putting nothing back fails WCAG 2.4.7."
    },
    {
      "name": "container",
      "type": "none",
      "typeName": "HTMLElement | null",
      "description": "Where the popup is rendered. Defaults to `document.body`, which is right almost always; pass an element to portal somewhere else, such as inside a frame or a container that owns its own stacking context."
    }
  ],
  "scene": [
    {
      "component": "NavigationMenu",
      "props": {
        "items": [
          {
            "label": "Files",
            "links": [
              {
                "title": "Recent",
                "href": "/files/recent",
                "description": "What you opened this week.",
                "icon": {
                  "$icon": "ClockCircleIcon",
                  "size": "w:5 h:5 c:blue"
                }
              },
              {
                "title": "Starred",
                "href": "/files/starred",
                "description": "The files you keep coming back to.",
                "icon": {
                  "$icon": "StarIcon",
                  "size": "w:5 h:5 c:yellow"
                }
              },
              {
                "title": "Trash",
                "href": "/files/trash",
                "description": "Deleted files, kept for 30 days.",
                "icon": {
                  "$icon": "TrashBinTrashIcon",
                  "size": "w:5 h:5 c:red"
                }
              }
            ]
          },
          {
            "label": "Library",
            "columns": 2,
            "links": [
              {
                "title": "Photos",
                "href": "/library/photos",
                "description": "Scans & pictures, by date.",
                "icon": {
                  "$icon": "GalleryIcon",
                  "size": "w:5 h:5 c:mint"
                }
              },
              {
                "title": "Videos",
                "href": "/library/videos",
                "description": "Clips, with the longest first.",
                "icon": {
                  "$icon": "VideoFrameIcon",
                  "size": "w:5 h:5 c:red"
                }
              },
              {
                "title": "Documents",
                "href": "/library/documents",
                "description": "Notes, sheets & PDFs.",
                "icon": {
                  "$icon": "DocumentIcon",
                  "size": "w:5 h:5 c:blue"
                }
              },
              {
                "title": "Archives",
                "href": "/library/archives",
                "description": "Zips you have not opened.",
                "icon": {
                  "$icon": "ArchiveIcon",
                  "size": "w:5 h:5 c:yellow"
                }
              }
            ]
          },
          {
            "label": "Settings",
            "href": "/settings"
          }
        ]
      }
    }
  ]
}
