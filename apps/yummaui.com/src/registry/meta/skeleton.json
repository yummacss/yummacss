{
  "summary": "A placeholder for content that has not arrived yet, in three shapes and two tones, with a pulse you can stagger or switch off.",
  "props": [
    {
      "name": "dimensions",
      "type": "string",
      "description": "Replaces the shape's default size, as literal width and height utilities: `\"w:9 h:9\"`. It replaces rather than adds to them, because a second width class would not reliably win: which of two utilities applies is decided by the stylesheet's rule order, not by their order in the attribute. Spelled out in full rather than built from a scale value, so the class scanner can see it in your source."
    },
    {
      "name": "delay",
      "type": "number",
      "default": 0,
      "description": "Seconds to offset the pulse by. Stagger a list with `delay={index * 0.15}` so its rows do not beat in unison.",
      "min": 0,
      "max": 2,
      "step": 0.2
    },
    {
      "name": "tone",
      "type": "enum",
      "values": ["default", "subtle"],
      "default": "default",
      "description": "`subtle` is one step lighter, for the secondary line in a pair."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": ["line", "block", "circle"],
      "default": "line",
      "description": "Corner radius, plus a default size: `line` for text, `block` for a control or thumbnail, `circle` for an avatar. Change the size with `dimensions`."
    },
    {
      "name": "animated",
      "type": "boolean",
      "default": true,
      "description": "The pulse. Turn it off for a static placeholder, or when the user has asked for reduced motion."
    }
  ],
