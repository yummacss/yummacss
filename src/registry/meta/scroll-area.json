{
  "summary": "Content that scrolls inside whatever holds it, with a thin scrollbar that shows while you hover or scroll.",
  "props": [
    {
      "name": "children",
      "type": "none",
      "typeName": "ReactNode",
      "description": "What scrolls."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": ["rounded", "square", "squircle"],
      "default": "rounded",
      "description": "Corner radius on the focus outline. The thumb is always a capsule."
    },
    {
      "name": "animated",
      "type": "boolean",
      "default": true,
      "description": "The scrollbar fading in while you hover or scroll. Turn it off for a scrollbar that is simply there, or when the user has asked for reduced motion."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Extra classes on the area. Its height lives here: `merge` folds them in last, so `h:96` replaces the default `h:72`."
    },
    {
      "name": "focus",
      "type": "boolean",
      "typeName": "boolean | string",
      "default": true,
      "description": "The focus outline. `true` draws it, `false` removes it along with the danger, error and success tints that ride with it, and a string of Yumma CSS utilities restyles it on every focusable part of the component, which is more than `className` reaches. Removing it outright and putting nothing back fails WCAG 2.4.7."
    }
  ],
