{
  "summary": "Folders and files in a tree that opens folder by folder, with a picked row and the arrow keys.",
  "props": [
    {
      "name": "items",
      "type": "none",
      "typeName": "FileTreeItem[]",
      "example": [
        {
          "id": "documents",
          "name": "Documents",
          "children": [
            {
              "id": "taxes",
              "name": "Taxes 2026",
              "children": [
                {
                  "id": "receipts",
                  "name": "receipts.zip",
                  "detail": "18 MB"
                },
                {
                  "id": "return",
                  "name": "tax-return.pdf",
                  "detail": "412 KB"
                }
              ]
            },
            {
              "id": "budget",
              "name": "budget.xlsx",
              "detail": "24 KB"
            },
            {
              "id": "readme",
              "name": "readme.md",
              "detail": "3 KB"
            }
          ]
        },
        {
          "id": "photos",
          "name": "Photos",
          "children": [
            {
              "id": "scan",
              "name": "scan-0412.png",
              "detail": "1.2 MB"
            },
            {
              "id": "beach",
              "name": "beach.jpg",
              "detail": "3.4 MB"
            }
          ]
        },
        {
          "id": "videos",
          "name": "Videos",
          "children": [
            {
              "id": "holiday",
              "name": "holiday.mov",
              "detail": "860 MB"
            }
          ]
        },
        {
          "id": "notes",
          "name": "notes.txt",
          "detail": "1 KB"
        }
      ],
      "description": "The tree, top level first. Each item's `id` and `name`, plus `children` for a folder and an optional `detail` and `icon`."
    },
    {
      "name": "label",
      "type": "string",
      "default": "Files",
      "description": "The tree's accessible name."
    },
    {
      "name": "defaultExpanded",
      "type": "none",
      "typeName": "string[]",
      "example": ["documents"],
      "controlled": true,
      "description": "The folders open on first render, by `id`. Pair `expanded` with `onExpandedChange` instead if you are controlling it."
    },
    {
      "name": "expanded",
      "type": "none",
      "typeName": "string[]",
      "description": "Controlled open folders, by `id`."
    },
    {
      "name": "onExpandedChange",
      "type": "none",
      "typeName": "(expanded: string[]) => void",
      "description": "Called with every open folder's `id` when one opens or closes."
    },
    {
      "name": "defaultSelected",
      "type": "string",
      "example": "budget",
      "controlled": true,
      "description": "The row picked on first render, by `id`. Pair `selected` with `onSelectedChange` instead if you are controlling it."
    },
    {
      "name": "selected",
      "type": "string",
      "controlled": true,
      "handler": "onSelectedChange",
      "description": "The controlled picked row, by `id`."
    },
    {
      "name": "onSelectedChange",
      "type": "none",
      "typeName": "(selected: string) => void",
      "description": "Called with the `id` of the row just picked."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": ["rounded", "square", "squircle"],
      "default": "rounded",
      "description": "Corner radius on the tree and on each row."
    },
    {
      "name": "animated",
      "type": "boolean",
      "default": true,
      "description": "The chevron's turn and the folder's open and close. Turn it off for an instant tree, or when the user has asked for reduced motion."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Extra classes. `merge` folds them in last, so one here replaces the component's own class for the same utility."
    },
    {
      "name": "focus",
      "type": "boolean",
      "typeName": "boolean | string",
      "default": true,
      "description": "The focus outline. `true` draws it, `false` removes it along with the danger, error and success tints that ride with it, and a string of Yumma CSS utilities restyles it on every focusable part of the component, which is more than `className` reaches. Removing it outright and putting nothing back fails WCAG 2.4.7."
    }
  ],
  "scene": [
    {
      "component": "FileTree",
      "props": {
        "items": [
          {
            "id": "documents",
            "name": "Documents",
            "children": [
              {
                "id": "taxes",
                "name": "Taxes 2026",
                "children": [
                  {
                    "id": "receipts",
                    "name": "receipts.zip",
                    "detail": "18 MB"
                  },
                  {
                    "id": "return",
                    "name": "tax-return.pdf",
                    "detail": "412 KB"
                  }
                ]
              },
              {
                "id": "budget",
                "name": "budget.xlsx",
                "detail": "24 KB"
              },
              {
                "id": "readme",
                "name": "readme.md",
                "detail": "3 KB"
              }
            ]
          },
          {
            "id": "photos",
            "name": "Photos",
            "children": [
              {
                "id": "scan",
                "name": "scan-0412.png",
                "detail": "1.2 MB"
              },
              {
                "id": "beach",
                "name": "beach.jpg",
                "detail": "3.4 MB"
              }
            ]
          },
          {
            "id": "videos",
            "name": "Videos",
            "children": [
              {
                "id": "holiday",
                "name": "holiday.mov",
                "detail": "860 MB"
              }
            ]
          },
          {
            "id": "notes",
            "name": "notes.txt",
            "detail": "1 KB"
          }
        ],
        "defaultExpanded": ["documents"],
        "defaultSelected": "budget"
      }
    }
  ]
}
