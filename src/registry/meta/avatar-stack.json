{
  "summary": "Overlapping avatars in one row, with an optional cap that collapses the rest into a +N avatar.",
  "props": [
    {
      "name": "overlap",
      "type": "enum",
      "values": ["none", "sm", "md", "lg"],
      "default": "md",
      "description": "How far each avatar sits over the one before it. `none` spaces them normally."
    },
    {
      "name": "max",
      "type": "number",
      "description": "Show at most this many avatars, then one more reading `+N` for the rest. Unset shows every avatar you pass.",
      "min": 1,
      "max": 8,
      "step": 1,
      "example": 3
    },
    {
      "name": "size",
      "type": "enum",
      "values": ["sm", "md", "lg"],
      "default": "sm",
      "description": "Size of the `+N` avatar only. The avatars you pass carry their own `size`."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Merged with the stack's own classes, so a utility you pass wins."
    }
  ],
  "childrenExample": [
    {
      "component": "Avatar",
      "props": {
        "size": "sm",
        "name": "This laptop",
        "fallback": {
          "$icon": "LaptopIcon",
          "size": "w:4 h:4"
        }
      }
    },
    {
      "component": "Avatar",
      "props": {
        "size": "sm",
        "name": "Phone",
        "fallback": {
          "$icon": "SmartphoneIcon",
          "size": "w:4 h:4"
        }
      }
    },
    {
      "component": "Avatar",
      "props": {
        "size": "sm",
        "name": "Tablet",
        "fallback": {
          "$icon": "TabletIcon",
          "size": "w:4 h:4"
        }
      }
    },
    {
      "component": "Avatar",
      "props": {
        "size": "sm",
        "name": "Desktop",
        "fallback": {
          "$icon": "MonitorIcon",
          "size": "w:4 h:4"
        }
      }
    }
  ],
  "scene": [
    {
      "tag": "div",
      "className": "d:g g:2 ji:c",
      "children": [
        {
          "component": "AvatarStack",
          "children": [
            {
              "component": "Avatar",
              "className": "bg:fill bc:raised bw:2",
              "props": {
                "name": "This laptop",
                "fallback": {
                  "$icon": "LaptopIcon",
                  "size": "w:6 h:6 c:on-fill"
                }
              }
            },
            {
              "component": "Avatar",
              "className": "bg:blue-8 bc:raised bw:2",
              "props": {
                "name": "Phone",
                "fallback": {
                  "$icon": "SmartphoneIcon",
                  "size": "w:6 h:6 c:white"
                }
              }
            },
            {
              "component": "Avatar",
              "className": "bg:mint-8 bc:raised bw:2",
              "props": {
                "name": "Tablet",
                "fallback": {
                  "$icon": "TabletIcon",
                  "size": "w:6 h:6 c:white"
                }
              }
            },
            {
              "component": "Avatar",
              "className": "bc:raised bw:2",
              "props": {
                "fallback": "+1"
              }
            }
          ]
        },
        {
          "text": "Synced on 4 devices",
          "className": "fs:sm c:hint"
        }
      ]
    }
  ]
}
