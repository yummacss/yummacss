{
  "summary": "An application menu bar: a row of dropdown menus, each built from the same item list as Menu.",
  "props": [
    {
      "name": "menus",
      "type": "none",
      "typeName": "MenubarMenu[]",
      "example": [
        {
          "label": "File",
          "items": [
            {
              "label": "New file",
              "icon": {
                "$icon": "DocumentAddIcon",
                "size": "w:4 h:4"
              },
              "shortcut": "Ctrl N"
            },
            {
              "label": "Import",
              "icon": {
                "$icon": "FileLeftIcon",
                "size": "w:4 h:4"
              }
            },
            {
              "label": "Export",
              "icon": {
                "$icon": "FileRightIcon",
                "size": "w:4 h:4"
              }
            }
          ]
        },
        {
          "label": "Edit",
          "items": [
            {
              "label": "Undo rename",
              "icon": {
                "$icon": "UndoLeftIcon",
                "size": "w:4 h:4"
              },
              "shortcut": "Ctrl Z"
            },
            {
              "label": "Copy",
              "icon": {
                "$icon": "CopyIcon",
                "size": "w:4 h:4"
              },
              "shortcut": "Ctrl C"
            },
            {
              "label": "Paste",
              "shortcut": "Ctrl V"
            },
            {
              "type": "separator"
            },
            {
              "label": "Select all",
              "shortcut": "Ctrl A"
            }
          ]
        },
        {
          "label": "View",
          "items": [
            {
              "label": "List",
              "icon": {
                "$icon": "ListIcon",
                "size": "w:4 h:4"
              }
            },
            {
              "label": "Grid",
              "icon": {
                "$icon": "Grid2x2Icon",
                "size": "w:4 h:4"
              }
            },
            {
              "label": "Columns",
              "icon": {
                "$icon": "Columns3Icon",
                "size": "w:4 h:4"
              }
            }
          ]
        },
        {
          "label": "Go",
          "items": [
            {
              "label": "Documents",
              "icon": {
                "$icon": "FolderIcon",
                "size": "w:4 h:4"
              }
            },
            {
              "label": "Downloads",
              "icon": {
                "$icon": "FolderIcon",
                "size": "w:4 h:4"
              }
            },
            {
              "label": "Trash",
              "icon": {
                "$icon": "TrashBinTrashIcon",
                "size": "w:4 h:4"
              }
            }
          ]
        }
      ],
      "description": "Each menu's `label`, its `items`, and an optional `disabled`. Every menu owns its own open state, so opening one closes the last."
    },
    {
      "name": "icon",
      "type": "boolean",
      "default": true,
      "description": "Draws each item's icon. `false` drops them, so every row shows its label alone."
    },
    {
      "name": "iconPosition",
      "type": "enum",
      "values": ["leading", "trailing"],
      "default": "leading",
      "description": "Which end of an item its `icon` sits at. A `shortcut` always trails regardless.",
      "conflictsWith": [
        {
          "prop": "icon",
          "set": false
        }
      ]
    },
    {
      "name": "shape",
      "type": "enum",
      "values": ["rounded", "square", "squircle"],
      "default": "rounded",
      "description": "Corner radius on the bar, its buttons, the popups and their items together."
    },
    {
      "name": "animated",
      "type": "boolean",
      "default": true,
      "description": "The popups' fade in/out. Turn it off for instant menus, or when the user has asked for reduced motion."
    },
    {
      "name": "container",
      "type": "none",
      "typeName": "HTMLElement | null",
      "description": "Where the popup is rendered. Defaults to `document.body`, which is right almost always; pass an element to portal somewhere else, such as inside a frame or a container that owns its own stacking context."
    }
  ]
}
