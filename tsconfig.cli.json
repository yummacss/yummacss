    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist/cli",
    "rootDir": "./cli",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["cli/**/*"],
  "exclude": ["node_modules", "dist"]
}
